<?xml version="1.0" encoding="utf-8"?>
<!--
  Sprint 13: VR HUD overlay.

  An always-visible floating quick-action panel anchored to the top-right
  of MainActivity's CoordinatorLayout. The panel is positioned just below
  the AppBar so it never overlaps the toolbar / search bar, and uses
  large hit targets (48 × 48 dp minimum) so that the Quest 3 controller
  pointer (a fairly coarse cursor compared to a touch screen) can hit
  every action reliably.

  The container is `focusable=true` and each ImageButton inside it is
  individually focusable to integrate with the Sprint 5 D-pad / gamepad
  navigation chain. selectableItemBackgroundBorderless gives a clear
  highlight when a button receives focus.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vr_hud_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="?attr/actionBarSize"
    android:layout_marginEnd="8dp"
    android:layout_marginRight="8dp"
    android:background="@drawable/vr_hud_background"
    android:elevation="8dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:ignore="UnusedAttribute"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageButton
        android:id="@+id/vr_hud_home"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_home_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_back"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_up"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_upward_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_forward"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_forward"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_forward_white_24dp"
        android:tint="@android:color/white" />

    <View
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#33ffffff" />

    <ImageButton
        android:id="@+id/vr_hud_search"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_search_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_drawer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/drawer_open"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_menu_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_view_options"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/view_options"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_settings_white_24dp"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/vr_hud_servers"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/vr_hud_servers"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_settings_remote_white_24dp"
        android:tint="@android:color/white" />
</LinearLayout>
